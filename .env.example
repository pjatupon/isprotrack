# MariaDB: root on localhost with no password.
DATABASE_URL="mysql://root@localhost:3306/isprotrack"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="isprotrack"

# Better Auth: generate a production secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini AI: get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# KKU GenAI (https://gen.ai.kku.ac.th): OpenAI-compatible chat completions
KKU_GENAI_API_KEY=""
KKU_GENAI_BASE_URL="https://gen.ai.kku.ac.th/api/v1"
KKU_GENAI_MODEL="gemini-2.5-flash-lite"
